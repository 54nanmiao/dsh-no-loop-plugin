    "client.js",
    "detector.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "loop",
    "reasoning",
    "guard",
    "deepseek-harness"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54nanmiao/dsh-no-loop-plugin.git"
  },
  "homepage": "https://github.com/54nanmiao/dsh-no-loop-plugin",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test-detector.mjs && node test-fp.mjs && node test-review.mjs && node test-stream.mjs && node test-tier.mjs && node test-ui.mjs && node test-client.mjs",
    "eval": "node eval-guard.mjs"
  }
}
